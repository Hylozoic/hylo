{% snippet 'header_redesign' %}
{% snippet 'macro: post_card' %}
{% snippet 'macro: actor_pill' %}
{% snippet 'macro: post_icon' %}

{% macro avatar_box(class, avatar_url) -%}
  <table class='{{class}}'>
    <tbody>
      <tr>
        <td class='avatar-cell'>
          <img class='avatar' src='{{avatar_url}}' />
        </td>
        <td class='content-cell'>
          {{ caller() }}
        </td>
      </tr>
    </tbody>
  </table>
{%- endmacro %}

{% macro space_label(post) %}
  {% if post.space_name %}
    {% set post_space_name = post.space_name %}
    <span class='space-label'>{% trans %}in {{post_space_name}}{% endtrans %}</span>
  {% endif %}
{% endmacro %}

{% macro posts_section(name, posts) %}
  {% if posts and posts|length > 0 %}
    <span id='{{name}}'></span>
    <div class='section'>
      <h3 class='section-title'>{% trans %}New {% endtrans %}{{name}}</h3>
      {% for post in posts %}
        {{ post_card(post, true) }}
      {% endfor %}
    </div>
  {% endif %}
{% endmacro %}

<div class='section'>
  {% set group_pill = actor_pill(group_name, group_avatar_url, group_url) %}
  {% trans %}Here's what's happened in the last {% endtrans %}{{ time_period }} {% trans %}in {% endtrans %}{{ group_pill }}

  {% set jump_count = 0 %}
  {% if discussions|length > 0 %}{% set jump_count = jump_count + 1 %}{% endif %}
  {% if events|length > 0 %}{% set jump_count = jump_count + 1 %}{% endif %}
  {% if offers|length > 0 %}{% set jump_count = jump_count + 1 %}{% endif %}
  {% if requests|length > 0 %}{% set jump_count = jump_count + 1 %}{% endif %}
  {% if resources|length > 0 %}{% set jump_count = jump_count + 1 %}{% endif %}
  {% if projects|length > 0 %}{% set jump_count = jump_count + 1 %}{% endif %}
  {% if proposals|length > 0 %}{% set jump_count = jump_count + 1 %}{% endif %}
  {% if upcoming|length > 0 %}{% set jump_count = jump_count + 1 %}{% endif %}
  {% if ending|length > 0 %}{% set jump_count = jump_count + 1 %}{% endif %}

  {% if jump_count > 2 %}
    <p style='margin-top: 5px;'>
      {% trans %}Jump to {% endtrans %}
      {% set sep = '' %}
      {% if discussions|length > 0 %}{{ sep }}<a href='#Discussions'>{% trans %}Discussions{% endtrans %}</a>{% set sep = ', ' %}{% endif %}
      {% if events|length > 0 %}{{ sep }}<a href='#Events'>{% trans %}Events{% endtrans %}</a>{% set sep = ', ' %}{% endif %}
      {% if offers|length > 0 %}{{ sep }}<a href='#Offers'>{% trans %}Offers{% endtrans %}</a>{% set sep = ', ' %}{% endif %}
      {% if requests|length > 0 %}{{ sep }}<a href='#Requests'>{% trans %}Requests{% endtrans %}</a>{% set sep = ', ' %}{% endif %}
      {% if resources|length > 0 %}{{ sep }}<a href='#Resources'>{% trans %}Resources{% endtrans %}</a>{% set sep = ', ' %}{% endif %}
      {% if projects|length > 0 %}{{ sep }}<a href='#Projects'>{% trans %}Projects{% endtrans %}</a>{% set sep = ', ' %}{% endif %}
      {% if proposals|length > 0 %}{{ sep }}<a href='#Proposals'>{% trans %}Proposals{% endtrans %}</a>{% set sep = ', ' %}{% endif %}
      {% if upcoming|length > 0 %}{{ sep }}<a href='#upcoming'>{% trans %}Upcoming Reminders{% endtrans %}</a>{% set sep = ', ' %}{% endif %}
      {% if ending|length > 0 %}{{ sep }}<a href='#ending'>{% trans %}Ending Soon{% endtrans %}</a>{% endif %}
    </p>
  {% endif %}
</div>

{% if posts_with_new_comments|length > 0 or chat_rooms|length > 0 %}
<div class='section'>
  <h3 class='section-title'>{% trans %}Active Conversations{% endtrans %}</h3>
  <div class='card'>
    {% for room in chat_rooms %}
      {% set room_num_new_chats = room.num_new_chats %}
      <div class='post-headline'>
        {% if room_num_new_chats > 1 %}
          {% trans %}{{room_num_new_chats}} new chats in{% endtrans %}
        {% else %}
          {% trans %}{{room_num_new_chats}} new chat in{% endtrans %}
        {% endif %}
        <a class='title' href='{{room.url}}'>{{room.name}}</a>
      </div>
    {% endfor %}

    {% for post in posts_with_new_comments %}
      {% set post_comment_count = post.comment_count %}
      <div class='post-headline'>
        {% if post_comment_count > 1 %}
          {% trans %}{{post_comment_count}} new comments in{% endtrans %}
        {% else %}
          {% trans %}{{post_comment_count}} new comment in{% endtrans %}
        {% endif %}
        <a href='{{post.url}}' class='title'>{{post.title}}</a>
        {{ space_label(post) }}
      </div>
    {% endfor %}
  </div>
</div>
{% endif %}

{{posts_section('Discussions', discussions)}}
{{posts_section('Events', events)}}
{{posts_section('Offers', offers)}}
{{posts_section('Requests', requests)}}
{{posts_section('Resources', resources)}}
{{posts_section('Projects', projects)}}
{{posts_section('Proposals', proposals)}}

{% if upcoming|length > 0 %}
<div class='section'>
  <span id='upcoming'></span>
      <h3 class='section-title'>
        {% trans %}Coming up in the next {% endtrans %}
        {% if time_period == 'day' %}2 days{% else %}week{% endif %}
      </h3>
  {% for post in upcoming %}
    <div class='card post-headline'>
      {{post_icon(post.type)}} <span>{{post.start_time}} - <a href='{{post.url}}'>{{post.title}}</a> {{ space_label(post) }}</span>
    </div>
  {% endfor %}
</div>
{% endif %}

{% if ending|length > 0 %}
<div class='section'>
  <span id='ending'></span>
      <h3 class='section-title'>
        {% trans %}Ending in the next {% endtrans %}
        {% if time_period == 'day' %}2 days{% else %}week{% endif %}
      </h3>
  {% for post in ending %}
    <div class='card post-headline'>
      {{post_icon(post.type)}} <span>{{post.end_time}} - <a href='{{post.url}}'>{{post.title}}</a> {{ space_label(post) }}</span>
    </div>
  {% endfor %}
</div>
{% endif %}
{% snippet 'footer_redesign' %}
