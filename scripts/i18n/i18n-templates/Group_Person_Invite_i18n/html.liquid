{% snippet 'header_redesign' %}
{% snippet "macro: actor_pill" %}

<style type='text/css'>
  blockquote.invitation-note {
    margin: 12px 0 0;
    padding: 8px 12px;
    border-left: 3px solid #d0d0d0;
    color: #444444;
  }
  .invitation-opt-out {
    font-size: 12px;
    color: #888888;
  }
</style>

{% set group_pill = actor_pill(group_name, group_avatar_url, group_url) %}
{% set default_message = "Hi!<br><br>I'm inviting you to join my community on Hylo." %}
{% set message_formatted = message.format(group_name)|default(default_message, true)|safe %}
{% set group_name_var = group_name %}

<p class="lead">
  {% trans %}You've been invited to join {{group_pill}} {% endtrans %} !
</p> 
 
<div class='card'>
  <div style='font-weight: bold; margin-top: 5px; margin-bottom: 10px;'>{{inviter_name}} {% trans %}invited you {% endtrans %}</div>
  <div>{{message_formatted}} 
  </div>
</div>   

{% if social_proof and member_count > 1 %}
  {% set member_count_var = member_count %}
  <p>{% trans %}{{member_count_var}} people are already in {{group_name_var}}.{% endtrans %}
  {% if recent_post_count > 1 %}
    {% set recent_post_count_var = recent_post_count %}
    {% trans %}They shared {{recent_post_count_var}} posts in the last 30 days.{% endtrans %}
  {% endif %}
  </p>
{% endif %}

<a class='btn btn-blue' href='{{invite_link}}'>{% trans %}Join {{group_name_var}}{% endtrans %}</a> 

{% if opt_out_url %}
  <p class='invitation-opt-out'><a href='{{opt_out_url}}' clicktracking="off">{% trans %}Stop invitations to this address{% endtrans %}</a></p>
{% endif %}

{% snippet 'footer_redesign' %}
