{% snippet 'header_redesign' %}

<style type='text/css'>
  p {
    font-size: 16px;
    line-height: 1.6;
  }
  .group {
    margin: 0 0 12px;
  }
</style>

<p>
  {% set user_name_var = first_name %}
  {% trans %}Hi {{user_name_var}},{% endtrans %}
</p>

<p>{% trans %}It's been a while since you visited Hylo, so we've been sending you fewer emails. Here's what's been happening in your groups.{% endtrans %}</p>

{% for group in groups %}
  <p class='group'>
    <a href='{{group.url}}'><strong>{{group.name}}</strong></a>
    {% if group.new_post_count > 0 %}
      <br />
      {% set new_post_count_var = group.new_post_count %}
      {% trans %}New posts since your last visit: {{new_post_count_var}}{% endtrans %}
    {% endif %}
  </p>
{% endfor %}

<a class='btn btn-blue' href='{{home_url}}'>{% trans %}Catch up on Hylo →{% endtrans %}</a>

<p>{% trans %}Direct messages and mentions still reach you by email.{% endtrans %} <a href='{{email_settings_url}}'>{% trans %}Choose which emails you get{% endtrans %}</a></p>

<p>{% trans %}The Hylo Team{% endtrans %}</p>

{% snippet 'footer_redesign' %}
