# Copy to .env and fill in values (see apps/mobile/.env or 1Password).
# Expo CLI loads this automatically when you run `yarn workspace mobile-leap start`.
# Values are read in app.config.ts → extra → src/config (no Metro plugin needed).

# Backend API (GraphQL + REST)
API_HOST=http://localhost:3001

# Web app URL (PrimaryWebView in Phase 4)
HYLO_WEB_BASE_URL=http://localhost:3000

# AsyncStorage key for mirrored session cookie
SESSION_COOKIE_KEY=hylo_session_cookie

# Verbose auth logging in Metro console
AUTH_DEBUG=false

# Include expo-dev-client in native prebuild (local dev only; leave unset on Bitrise release)
# USE_EXPO_DEV_CLIENT=true

# Google Sign-In (dev build only — not Expo Go)
IOS_GOOGLE_CLIENT_ID=
WEB_GOOGLE_CLIENT_ID=

# Push notifications (OneSignal) — requires `yarn ios` rebuild after adding
# ONESIGNAL_APP_ID=
# ONESIGNAL_APN_MODE=development

# Crash reporting (Sentry) — optional for local dev
# SENTRY_DEV_DSN_URL=
# SENTRY_DSN_URL=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Support chat (Intercom) — requires rebuild when keys are added
# INTERCOM_APP_ID=
# INTERCOM_IOS_API_KEY=
# INTERCOM_ANDROID_API_KEY=

# Analytics (Mixpanel) — JS-only, no rebuild needed
# MIXPANEL_TOKEN=

# Location search during signup (Mapbox) — JS-only, no rebuild needed
# MAPBOX_TOKEN=

# Android push / Google Sign-In (when enabling OneSignal or Google on Android)
# Place google-services.json in apps/mobile-leap/ for package com.hylo.hyloandroid
# (same package as legacy — reuse google-services.json from the code-signing repo, android branch)

# Apple code signing (required for simulator builds once Sign in with Apple is enabled)
# Legacy apps/mobile uses L4KZBPS2F3 — use your team ID if different.
# APPLE_TEAM_ID=L4KZBPS2F3

# EAS (optional for local dev; required for cloud builds)
# EAS_PROJECT_ID=
#
# EAS build profiles (eas.json) set API_HOST / HYLO_WEB_BASE_URL for preview and production.
# Bitrise can use the same env vars at build time — EAS is optional.
# Set secrets in EAS for keys that must not be in git:
#   eas secret:create --name ONESIGNAL_APP_ID --value ...
#   eas secret:create --name SENTRY_DSN_URL --value ...

# Maestro E2E (export in shell before yarn e2e:maestro:login — not read from this file)
# MAESTRO_TEST_EMAIL=
# MAESTRO_TEST_PASSWORD=
