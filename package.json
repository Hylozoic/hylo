{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build-packages": "yarn workspaces foreach --recursive --from='packages/*' --topological --verbose run build",
    "shared:build": "yarn workspace @hylo/shared build",
    "backend:dev": "yarn build-packages && yarn workspace backend run dev",
    "cron": "yarn workspace backend cron",
    "digest:daily": "yarn workspace backend digest:daily",
    "worker": "yarn workspace backend worker",
    "migrate": "yarn workspace backend migrate",
    "migrate-up": "yarn workspace backend migrate-up",
    "web:dev": "yarn build-packages && yarn workspace web run dev",
    "mobile:dev": "yarn build-packages && yarn workspace mobile-leap start",
    "mobile:ios": "yarn workspace mobile-leap ios",
    "mobile:android": "yarn workspace mobile-leap android",
    "mobile-leap:dev": "yarn workspace mobile-leap start",
    "mobile-leap:dev-client": "yarn workspace mobile-leap start:dev-client",
    "mobile-leap:ios": "yarn workspace mobile-leap ios",
    "mobile-leap:android": "yarn workspace mobile-leap android",
    "desktop": "yarn workspace desktop start",
    "desktop:build": "yarn workspace desktop make",
    "reset": "rm -rf **/node_modules **/.yarn/cache **/yarn.lock && yarn install",
    "heroku-postbuild": "./heroku-postbuild.sh"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "yarn@4.9.2",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "standard": "^17.1.2",
    "ts-jest": "^29.4.0",
    "typescript": "5.0.4"
  },
  "resolutions": {
    "@deck.gl/core": "9.0.35",
    "@deck.gl/geo-layers": "9.0.35",
    "@luma.gl/core": "9.0.28",
    "@luma.gl/engine": "9.0.28",
    "@luma.gl/constants": "9.0.28",
    "@luma.gl/gltf": "9.0.28",
    "@emotion/utils": "^1.1.0",
    "@emotion/sheet": "^1.1.0",
    "htmlparser2": "9.1.0",
    "entities": "4.5.0",
    "nativewind/react-native-css-interop": "0.1.22",
    "mobile-leap@workspace:apps/mobile-leap>react-native-reanimated": "4.3.1"
  },
  "version": "1.0.0",
  "dependencies": {
    "archiver": "^7.0.1"
  }
}
